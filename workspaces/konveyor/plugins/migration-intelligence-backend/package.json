{
  "name": "@red-hat-developer-hub/backstage-plugin-migration-intelligence-backend",
  "version": "0.1.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "backstage": {
    "role": "backend-plugin",
    "pluginId": "migration-intelligence",
    "pluginPackage": "@red-hat-developer-hub/backstage-plugin-migration-intelligence-backend",
    "pluginPackages": [
      "@red-hat-developer-hub/backstage-plugin-migration-intelligence",
      "@red-hat-developer-hub/backstage-plugin-migration-intelligence-backend"
    ]
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "package.json": [
        "package.json"
      ]
    }
  },
  "scripts": {
    "build": "backstage-cli package build",
    "clean": "backstage-cli package clean",
    "lint:check": "backstage-cli package lint",
    "lint:fix": "backstage-cli package lint --fix",
    "postpack": "backstage-cli package postpack",
    "prepack": "backstage-cli package prepack",
    "start": "backstage-cli package start",
    "test": "backstage-cli package test --passWithNoTests --coverage",
    "tsc": "tsc",
    "prettier:check": "prettier --ignore-unknown --check .",
    "prettier:fix": "prettier --ignore-unknown --write ."
  },
  "dependencies": {
    "@backstage/backend-defaults": "^0.16.0",
    "@backstage/backend-plugin-api": "^1.8.0",
    "@backstage/config": "^1.3.6",
    "@backstage/errors": "^1.2.7",
    "@kubernetes/client-node": "^1.0.0",
    "express": "^4.21.1",
    "knex": "^3.1.0"
  },
  "devDependencies": {
    "@backstage/cli": "^0.36.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.4.0",
    "@spotify/prettier-config": "^15.0.0",
    "@types/express": "4.17.25",
    "prettier": "3.8.3"
  },
  "files": [
    "dist",
    "migrations"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/redhat-developer/rhdh-plugins.git",
    "directory": "workspaces/konveyor/plugins/migration-intelligence-backend"
  },
  "keywords": [
    "backstage",
    "plugin"
  ],
  "homepage": "https://red.ht/rhdh",
  "bugs": "https://github.com/redhat-developer/rhdh-plugins/issues"
}
