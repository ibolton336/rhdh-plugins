{
  "name": "@red-hat-developer-hub/backstage-plugin-migration-intelligence",
  "version": "0.1.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./src/index.ts",
    "./alpha": "./src/alpha/index.tsx",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "alpha": [
        "src/alpha/index.tsx"
      ],
      "package.json": [
        "package.json"
      ]
    }
  },
  "backstage": {
    "role": "frontend-plugin",
    "pluginId": "migration-intelligence",
    "pluginPackage": "@red-hat-developer-hub/backstage-plugin-migration-intelligence",
    "pluginPackages": [
      "@red-hat-developer-hub/backstage-plugin-migration-intelligence",
      "@red-hat-developer-hub/backstage-plugin-migration-intelligence-backend"
    ]
  },
  "sideEffects": false,
  "scripts": {
    "build": "backstage-cli package build",
    "clean": "backstage-cli package clean",
    "lint:check": "backstage-cli package lint",
    "lint:fix": "backstage-cli package lint --fix",
    "postpack": "backstage-cli package postpack",
    "prepack": "backstage-cli package prepack",
    "start": "backstage-cli package start",
    "test": "backstage-cli package test --passWithNoTests --coverage",
    "tsc": "tsc",
    "prettier:check": "prettier --ignore-unknown --check .",
    "prettier:fix": "prettier --ignore-unknown --write ."
  },
  "dependencies": {
    "@backstage/core-components": "^0.18.8",
    "@backstage/core-plugin-api": "^1.12.4",
    "@backstage/frontend-plugin-api": "^0.15.1",
    "@backstage/theme": "^0.7.2",
    "@material-ui/core": "^4.9.13",
    "@material-ui/icons": "^4.11.3",
    "@material-ui/lab": "^4.0.0-alpha.61",
    "react-use": "^17.2.4"
  },
  "peerDependencies": {
    "react": "16.13.1 || ^17.0.0 || ^18.0.0",
    "react-router-dom": "^6.0.0"
  },
  "devDependencies": {
    "@backstage/cli": "^0.36.0",
    "@backstage/core-app-api": "^1.19.6",
    "@backstage/dev-utils": "^1.1.21",
    "@backstage/test-utils": "^1.7.16",
    "@ianvs/prettier-plugin-sort-imports": "^4.4.0",
    "@spotify/prettier-config": "^15.0.0",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^15.0.0",
    "@testing-library/user-event": "14.6.1",
    "msw": "1.3.5",
    "prettier": "3.8.3",
    "react": "16.13.1 || ^17.0.0 || ^18.0.0",
    "react-dom": "16.13.1 || ^17.0.0 || ^18.0.0",
    "react-router-dom": "^6.0.0"
  },
  "files": [
    "dist",
    "dist-scalprum",
    "app-config.dynamic.yaml"
  ],
  "scalprum": {
    "name": "red-hat-developer-hub.backstage-plugin-migration-intelligence",
    "exposedModules": {
      "Alpha": "./src/alpha/index.tsx",
      "PluginRoot": "./src/index.ts",
      "MigrationIntelligencePlugin": "./src/index.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/redhat-developer/rhdh-plugins.git",
    "directory": "workspaces/konveyor/plugins/migration-intelligence"
  },
  "keywords": [
    "backstage",
    "plugin",
    "konveyor",
    "migration"
  ],
  "homepage": "https://red.ht/rhdh",
  "bugs": "https://github.com/redhat-developer/rhdh-plugins/issues",
  "maintainers": [
    "@ibolton336"
  ],
  "author": "Red Hat"
}
